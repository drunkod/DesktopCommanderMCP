FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/control-plane/package.json ./apps/control-plane/package.json
COPY packages/protocol/package.json ./packages/protocol/package.json
RUN pnpm install --frozen-lockfile

COPY apps/control-plane ./apps/control-plane
COPY packages/protocol ./packages/protocol

ENV APP_ORIGIN=http://127.0.0.1:3000
ENV BETTER_AUTH_SECRET=build-only-not-for-runtime
ENV BETTER_AUTH_DB_PATH=:memory:
ENV REMOTE_MCP_RESOURCE=http://127.0.0.1:3000/mcp
ENV JAZZ_APP_ID=00000000-0000-0000-0000-000000000001
ENV JAZZ_SERVER_URL=http://127.0.0.1:1625
ENV JAZZ_INTERNAL_SERVER_URL=http://127.0.0.1:1625
ENV JAZZ_ADMIN_SECRET=build-only
ENV JAZZ_BACKEND_SECRET=build-only
ENV NEXT_PUBLIC_JAZZ_APP_ID=00000000-0000-0000-0000-000000000001
ENV NEXT_PUBLIC_JAZZ_SERVER_URL=http://127.0.0.1:1625

RUN pnpm --filter @remote-dc/control-plane build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY --from=build /app /app
RUN mkdir -p /data/auth
EXPOSE 3000
CMD ["pnpm", "--filter", "@remote-dc/control-plane", "start"]
