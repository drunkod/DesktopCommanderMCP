{
  "name": "@remote-dc/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "BETTER_AUTH_DB_PATH=:memory: next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "check": "pnpm check:passkey-uv && pnpm test:passkey-migration && pnpm test:passkey-account && pnpm test:passkey-security && pnpm test:oauth-revocation && pnpm test:cutover-control && pnpm test:cutover-runner && pnpm test:device-launcher && pnpm test:cutover-readiness && pnpm test:worker-queue && pnpm test:worker-mcp && pnpm test:worker-restart && tsc --noEmit",
    "cleanup:calls": "tsx ./scripts/cleanup-calls.ts",
    "jazz:serve": "tsx ./scripts/jazz-authority.ts",
    "jazz:validate": "jazz-tools validate",
    "jazz:deploy": "jazz-tools deploy $JAZZ_APP_ID",
    "auth:plan": "auth migrate --config ./lib/auth-migration-config.ts",
    "auth:migrate": "auth migrate --config ./lib/auth-migration-config.ts --yes",
    "passkey:enroll-test": "tsx ./scripts/create-passkey-enrollment.ts",
    "check:passkey-uv": "node ./scripts/check-passkey-uv-patch.mjs",
    "test:passkey-account": "node ./scripts/test-passkey-account-registration.mjs",
    "test:oauth-revocation": "tsx ./scripts/test-oauth-revocation-wrapper.ts",
    "test:passkey-migration": "node ./scripts/test-passkey-only-identity-migration.mjs",
    "test:passkey-security": "tsx ./scripts/test-passkey-security-negatives.ts",
    "worker:enqueue": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/enqueue-worker-task.ts",
    "worker:tasks": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/list-worker-tasks.ts",
    "worker:inspect": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/inspect-worker-session.ts",
    "cutover:inspect": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/inspect-cutover-readiness.ts",
    "cutover:quiesce-workers": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/quiesce-worker-sessions.ts",
    "device:registry": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/inspect-device-registry.ts",
    "device:reconcile-identity": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/reconcile-device-identity.ts",
    "device:rehearse-branch-repair": "bash ../../ops/macos/rehearse-jazz-device-branch-repair.sh",
    "device:rehearse-clean-reseed": "bash ../../ops/macos/rehearse-jazz-clean-authority-reseed.sh",
    "test:cutover-readiness": "tsx ./scripts/test-cutover-readiness.ts",
    "test:cutover-control": "bash ../../ops/macos/test-cutover-control.sh",
    "test:cutover-runner": "bash ../../ops/macos/test-run-local-stack-maintenance.sh",
    "test:device-launcher": "bash ../../ops/macos/test-local-device-launcher.sh",
    "test:worker-queue": "tsx ./scripts/test-worker-queue.ts",
    "test:worker-mcp": "tsx ./scripts/test-worker-mcp.ts",
    "test:worker-restart": "tsx ./scripts/test-worker-restart.ts",
    "worker:soak:observe": "NODE_ENV=production node --env-file=.env.local --import tsx ./scripts/observe-worker-soak.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.1",
    "@better-auth/mcp": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@remote-dc/protocol": "workspace:*",
    "better-auth": "1.7.1",
    "jazz-tools": "2.0.0-alpha.53",
    "jose": "6.2.10",
    "next": "^15.5.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "auth": "1.7.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
