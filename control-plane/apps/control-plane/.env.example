APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_DB_PATH=/absolute/path/to/remote-mcp-jazz/.data/better-auth.sqlite
# MVP-only DCR escape hatch; keep false unless intentionally testing public client registration.
ALLOW_UNAUTHENTICATED_OAUTH_CLIENT_REGISTRATION=false
# Secure/default token lifetime is 300s. Local no-chat MVP may raise this above 1500s.
OAUTH_ACCESS_TOKEN_EXPIRES_IN=300
REMOTE_MCP_RESOURCE=http://localhost:3000/mcp

JAZZ_APP_ID=replace-with-jazz-app-id
JAZZ_SERVER_URL=http://127.0.0.1:1625
# Server-side app can use a private service address in containers.
JAZZ_INTERNAL_SERVER_URL=http://127.0.0.1:1625
# Persistent NAPI cache for the trusted control-plane backend client.
JAZZ_BACKEND_DATA_PATH=/absolute/path/to/remote-mcp-jazz/.data/jazz-backend-runtime.db
JAZZ_ADMIN_SECRET=replace-with-admin-secret
JAZZ_BACKEND_SECRET=replace-with-backend-secret

# Jazz trusts only dedicated short-lived capability JWTs, not general OAuth/session JWTs.
JAZZ_TOKEN_PRIVATE_JWK_B64=replace-with-base64url-private-jwk
JAZZ_TOKEN_PUBLIC_JWK_B64=replace-with-base64url-public-jwk
JAZZ_JWKS_URL=http://localhost:3000/.well-known/jazz-jwks

# Device process uses JAZZ_SERVER_URL + APP_ORIGIN, never admin/backend secrets.

# Browser dashboard receives only public Jazz connection coordinates.
NEXT_PUBLIC_JAZZ_APP_ID=replace-with-jazz-app-id
NEXT_PUBLIC_JAZZ_SERVER_URL=http://127.0.0.1:1625
